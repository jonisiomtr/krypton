# ========================================
# AMBIENTE DE PRODUÇÃO
# ========================================
# Copie este arquivo para o servidor e preencha com valores reais

# ========================================
# MERCADO PAGO CONFIGURAÇÃO - CEO (SaaS)
# ========================================
# Use credenciais de PRODUÇÃO no servidor
MP_CLIENT_ID=SEU_CLIENT_ID_PRODUCAO
MP_CLIENT_SECRET=SEU_CLIENT_SECRET_PRODUCAO
MP_WEBHOOK_URL=https://seudominio.com/payments/webhook/mercadopago
MP_REDIRECT_URI=https://seudominio.com/mercadopago/callback

# ========================================
# CRIPTOGRAFIA (32 bytes para AES-256-GCM)
# ========================================
# Use a chave diferente de desenvolvimento
# Gerar nova chave: node scripts/generate-encryption-key.js
ENCRYPTION_KEY=SUA_CHAVE_DE_32_CARACTERES_PARA_PRODUCAO

# ========================================
# AMBIENTE MERCADO PAGO
# ========================================
# production = ambiente real
MP_ENV=production

# ========================================
# CONFIGURAÇÃO SMTP (ENVIO DE E-MAIL)
# ========================================
# Recomendado: SendGrid ou outro serviço de e-mail transactional
# Gmail funciona mas tem limites de envio
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.SUA_CHAVE_SENDGRID
SMTP_FROM=KRYPTON SaaS <noreply@seudominio.com>

# ========================================
# CLOUDINARY (Opcional - para upload de imagens)
# ========================================
# Se não usar, remova estas linhas
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret

# ========================================
# ASAAS (Opcional - para PIX automático)
# ========================================
# Se não usar, remova estas linhas
ASAAS_API_KEY=SUA_CHAVE_ASAAS
ASAAS_API_URL=https://sandbox.asaas.com.br
